<table role="presentation" cellpadding="0" cellspacing="0" style="margin:24px 0;">
  <tr>
    <td style="background:@Brand.Color;border-radius:6px;">
      <a href="@Href" style="display:inline-block;padding:12px 24px;color:#ffffff;font-weight:600;text-decoration:none;font-size:16px;">@Label</a>
    </td>
  </tr>
</table>
<p style="font-size:13px;color:#6b7280;word-break:break-all;">If the button doesn't work, copy this link into your browser:<br /><a href="@Href" style="color:@Brand.Color;">@Href</a></p>

@code {
    [Parameter, EditorRequired] public string Href { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
}
