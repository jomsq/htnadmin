<EmailLayout Title="@($"Your {EventName} registration was cancelled")" Preheader="Your registration and its QR codes are no longer valid." BrandColor="@BrandColor" LogoCid="@LogoCid" Heading="@EventName">
  <h1 style="margin:0 0 12px;font-size:22px;line-height:1.3;color:#111827;">Registration cancelled</h1>
  <p style="margin-top:0;">Hi @FirstName, your registration for <strong>@EventName</strong> (@ParticipantIds) was cancelled. Any QR code sent for it no longer works.</p>
  <p>If you think this is a mistake, reply to this email or contact the organizers.</p>
</EmailLayout>

@code {
    [Parameter, EditorRequired] public string FirstName { get; set; } = "";
    [Parameter, EditorRequired] public string EventName { get; set; } = "";
    [Parameter, EditorRequired] public string ParticipantIds { get; set; } = "";
    [Parameter] public string BrandColor { get; set; } = Brand.Color;
    [Parameter] public string? LogoCid { get; set; }
}
