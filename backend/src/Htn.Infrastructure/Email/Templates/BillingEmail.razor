<EmailLayout Title="@($"Complete your payment for {EventName}")" Preheader="@($"Send {Amount} with reference {ParticipantId} before {Deadline}.")" BrandColor="@BrandColor" LogoCid="@LogoCid" Heading="@EventName">
  <h1 style="margin:0 0 12px;font-size:22px;line-height:1.3;color:#111827;">Complete your payment, @FirstName</h1>
  <p style="margin-top:0;">
    Thanks for registering. Your seat is held for @DeadlineHours hours. Send <strong>@Amount</strong> with reference
    <strong style="font-family:Menlo,Consolas,monospace;">@ParticipantId</strong> in the message.
  </p>

  @foreach (var line in PayTo)
  {
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:12px 0;border:1px solid #e5e7eb;border-radius:6px;">
      <tr>
        <td style="padding:12px 16px;">
          <div style="font-size:12px;font-weight:700;letter-spacing:0.04em;color:#4b5563;">@line.Heading</div>
          <div style="font-size:15px;color:#111827;">@line.AccountName</div>
          @if (line.AccountNumber is not null)
          {
            <div style="font-size:15px;font-weight:600;color:#111827;font-family:Menlo,Consolas,monospace;">@line.AccountNumber</div>
          }
        </td>
      </tr>
    </table>
  }

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:16px 0;border-top:1px solid #e5e7eb;border-bottom:1px solid #e5e7eb;">
    <tr>
      <td style="padding:10px 0;color:#374151;">@TicketLine</td>
      <td style="padding:10px 0;text-align:right;font-weight:700;">@Amount</td>
    </tr>
    <tr>
      <td style="padding:10px 0;color:#374151;">Pay before</td>
      <td style="padding:10px 0;text-align:right;font-weight:600;">@Deadline</td>
    </tr>
  </table>

  @if (UploadLink is not null)
  {
    <EmailButton Href="@UploadLink" Label="Upload proof of payment" BrandColor="@BrandColor" />
  }
  else
  {
    <p><strong>After paying, reply to this email</strong> with a screenshot of your payment and your participant ID <strong>@ParticipantId</strong>.</p>
  }
  <p style="font-size:14px;color:#4b5563;">Your ticket and QR code arrive once our team confirms payment.</p>
</EmailLayout>

@code {
    [Parameter, EditorRequired] public string FirstName { get; set; } = "";
    [Parameter, EditorRequired] public string EventName { get; set; } = "";
    [Parameter, EditorRequired] public string Amount { get; set; } = "";
    [Parameter, EditorRequired] public string ParticipantId { get; set; } = "";
    [Parameter, EditorRequired] public string TicketLine { get; set; } = "";
    [Parameter, EditorRequired] public string Deadline { get; set; } = "";
    [Parameter] public int DeadlineHours { get; set; } = 48;
    [Parameter] public IReadOnlyList<PayToLine> PayTo { get; set; } = [];
    [Parameter] public string? UploadLink { get; set; }
    [Parameter] public string BrandColor { get; set; } = Brand.Color;
    [Parameter] public string? LogoCid { get; set; }
}
