<EmailLayout Title="Reset your password" Preheader="This link expires in 30 minutes.">
  <p style="margin-top:0;">Hi @FirstName,</p>
  <p>We received a request to reset the password for your @Brand.OrgName Admin account.</p>
  <p>The link works once and expires in @ExpiresInMinutes minutes. If you didn't ask for this, you can ignore this email; your password stays the same.</p>
  <EmailButton Href="@Link" Label="Reset password" />
</EmailLayout>

@code {
    [Parameter, EditorRequired] public string FirstName { get; set; } = "";
    [Parameter, EditorRequired] public string Link { get; set; } = "";
    [Parameter] public int ExpiresInMinutes { get; set; } = 30;
}
