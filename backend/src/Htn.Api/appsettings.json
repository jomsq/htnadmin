{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Db": ""
  },
  "App": {
    "PublicBaseUrl": "http://localhost:5173"
  },
  "Auth": {
    "RequireBoard2fa": true,
    "SecurityStampValidationInterval": "00:01:00",
    "SessionLifetime": "08:00:00",
    "Tokens": {
      "InviteLifetime": "2.00:00:00",
      "PasswordResetLifetime": "00:30:00"
    }
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  },
  "Outbox": {
    "Enabled": true,
    "PollSeconds": 5,
    "BatchSize": 20
  }
}
